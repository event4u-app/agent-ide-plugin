<idea-plugin>
    <id>de.event4u.agent</id>
    <name>event4u Agent</name>
    <vendor email="dev@event4u.de" url="https://event4u.de">event4u</vendor>

    <description><![CDATA[
        event4u Agent — AI coding assistant powered by your agent-config tree.
        Tool window chat + cost-tracking statusbar widget + Anthropic / Claude CLI mode.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="event4u-agent"
            anchor="right"
            factoryClass="de.event4u.agent.AgentToolWindowFactory"/>
        <statusBarWidgetFactory
            id="event4u-agent.status"
            implementation="de.event4u.agent.statusbar.AgentStatusBarWidgetFactory"
            order="last"/>
        <!-- T-1304 / T-PRD07 — workspace index-status widget. -->
        <statusBarWidgetFactory
            id="event4u-agent.index-status"
            implementation="de.event4u.agent.statusbar.AgentIndexStatusWidgetFactory"
            order="before event4u-agent.status"/>
        <applicationConfigurable
            parentId="tools"
            instance="de.event4u.agent.settings.AgentConfigurable"
            id="event4u-agent.settings"
            displayName="event4u Agent"/>
        <applicationService serviceImplementation="de.event4u.agent.settings.AgentSettings"/>
        <!-- T-MR10 — multi-project: auto-detect open module content roots. -->
        <projectService serviceImplementation="de.event4u.agent.workspace.WorkspaceFolderService"/>
        <!-- T-1304 / T-PRD07 — holds the latest per-root index status for the widget. -->
        <projectService serviceImplementation="de.event4u.agent.statusbar.IndexStatusService"/>
        <postStartupActivity implementation="de.event4u.agent.workspace.WorkspaceFolderStartup"/>
    </extensions>

    <actions>
        <action
            id="event4u-agent.askSelection"
            class="de.event4u.agent.actions.AskAboutSelectionAction"
            text="Ask event4u about Selection">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control shift A"/>
        </action>
    </actions>
</idea-plugin>
