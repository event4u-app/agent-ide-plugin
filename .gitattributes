# Normalise line endings to LF on checkout for all platforms so Prettier's
# --check passes on Windows CI runners (CRLF checkouts would fail it).
* text=auto eol=lf

# Windows-native scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never normalise.
*.jar binary
*.zip binary
*.png binary
*.vsix binary
